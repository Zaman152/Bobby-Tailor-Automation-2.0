# ──────────────────────────────────────────────────────────────────────
# StackCT Credentials
# ──────────────────────────────────────────────────────────────────────
STACKCT_EMAIL=your_stackct_login_email@example.com
STACKCT_PASSWORD=your_stackct_password

# Reuse screenshots from prior runs to skip StackCT blob downloads (default: true)
# Set to false to force a fresh download on every run.
REUSE_SCREENSHOTS=true

# ──────────────────────────────────────────────────────────────────────
# Anthropic API Configuration
# ──────────────────────────────────────────────────────────────────────
# Get your API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Default model used for most sheets (July 2026 line-up, per 1M tokens in/out)
#   claude-haiku-4-5   → $1/$5    (classification, cheap ensemble members)
#   claude-sonnet-5    → $2/$10   (workhorse; rises to $3/$15 on 2026-09-01)
#   claude-opus-4-8    → $5/$25   (dense tables/legends, high-res vision class)
#   claude-fable-5     → $10/$50  (frontier; escalation only, budget-gated)
CLAUDE_MODEL=claude-haiku-4-5

# Smart-routing: model auto-selected for sheets whose name contains
# SCHEDULE/PANEL/RISER/EQUIPMENT or matches an E/M/P sheet code
CLAUDE_MODEL_SCHEDULES=claude-sonnet-5

# ── Phase 21: Model Routing v2 (config-driven — no hardcoded slugs) ────────
# Semantic labeling passes on floor/roof/MEP plans (overlay + crop galleries)
CLAUDE_MODEL_SEMANTIC=claude-sonnet-5

# Dense small-text structuring: legend/schedule passes + verify-retry arbitration
CLAUDE_MODEL_DENSE=claude-opus-4-8

# Escalation model for repeated ensemble disagreement (used only when enabled below)
CLAUDE_MODEL_ESCALATION=claude-fable-5

# Cheap classification passes (sheet-type triage)
CLAUDE_MODEL_CLASSIFY=claude-haiku-4-5

# Escalation gate — Fable 5 is budget-gated OFF by default (cost guard)
ESCALATION_ENABLED=false

# Whole-sheet render long-edge target in px (Claude downscales to ~1568 anyway)
RENDER_TARGET_PX=1568

# ──────────────────────────────────────────────────────────────────────
# Browser Settings
# ──────────────────────────────────────────────────────────────────────
# Run browser headless (true for server deployments, false to watch it work)
HEADLESS=true

# Canvas stability before screenshot (seconds; increase on slow VPS)
CANVAS_STABILITY_TIMEOUT=15
CANVAS_STABILITY_CHECKS=2

# ──────────────────────────────────────────────────────────────────────
# Output Configuration
# ──────────────────────────────────────────────────────────────────────
# Where reports and screenshots are written
OUTPUT_DIR=./output

# Hours before StackCT project/plan catalog is considered stale (default 24)
STACKCT_CACHE_TTL_HOURS=24

# Days to retain completed job history in SQLite (0 = keep forever, default 90)
JOB_HISTORY_RETENTION_DAYS=90

# SQLite learning store — read by bobbytailor.learning.store (Phase 21)
LEARNING_DB_PATH=output/learning.db

# ──────────────────────────────────────────────────────────────────────
# Schedule Configuration
# ──────────────────────────────────────────────────────────────────────
# Cron expression for automated runs (default: daily at 8am)
# Format: minute hour day month weekday
# Examples:
#   0 8 * * *     → daily at 8:00 AM
#   0 */6 * * *   → every 6 hours
#   0 0 * * 1     → every Monday at midnight
RUN_SCHEDULE=0 8 * * *

# ──────────────────────────────────────────────────────────────────────
# Application Authentication (Phase 12)
# ──────────────────────────────────────────────────────────────────────
# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production. App will not start without this.
SECRET_KEY=your-random-secret-key-here

# Admin login credentials — set by running: python seed_admin.py
# Never put plaintext password here — only the bcrypt hash
ADMIN_EMAIL=admin@bobbytailor.com
ADMIN_PASSWORD_HASH=$2b$12$...bcrypt-hash-from-seed_admin.py...

# Set to "development" locally to disable Secure cookie flag (HTTP)
# Leave unset in production (defaults to secure mode)
# FLASK_ENV=development

# Rate limit storage — memory:// is single-process only (fine for dev)
# On gunicorn with multiple workers, use Redis so limits are shared:
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=memory://

# ── Phase 18: Linked Sheet Auto-Follow ────────────────────────────────────────
# When true, sheets referenced by cross-references are automatically captured
# and analyzed so detail specs resolve instead of showing target_sheet_not_found.
AUTO_INCLUDE_LINKED_SHEETS=true

# Maximum number of linked sheets added per run (cost/time safety cap).
MAX_LINKED_SHEETS=10

# Link-follow recursion depth. v1 supports depth 1 only (non-recursive).
MAX_LINKED_DEPTH=1
